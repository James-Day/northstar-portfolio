    "attributionText": "Historical daily prices sourced from the DoltHub post-no-preference/stocks dataset, licensed CC BY-SA 4.0.",
    "sourceLink": "https://www.dolthub.com/repositories/post-no-preference/stocks",
    "licenseLink": "https://creativecommons.org/licenses/by-sa/4.0/",
    "changeNoticeRequired": true,
    "shareAlikeNoticeRequired": true,
    "implementationStatus": "required_before_user_facing_paid_use"
  },
  "launchGate": {
    "paidStorageAndDisplay": "blocked_pending_rights_review",
    "requiredEvidence": [
      "rights review covers the exact stored subset and paid user-facing display",
      "attribution and license notice are present wherever the dataset or adapted database is distributed",
      "change notice and compatible share-alike terms are approved for any adapted database distribution"
    ]
  }
