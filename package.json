{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "dev:api": "wrangler dev --config wrangler.api.toml",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security": "vitest run services/security/rls-schema.test.ts",
    "preflight:launch": "node --experimental-strip-types scripts/launch-preflight.ts",
    "marketstack:dev-status": "node --experimental-strip-types scripts/marketstack-dev-status.ts",
    "marketstack:dev-smoke": "node --experimental-strip-types scripts/marketstack-dev-smoke.ts",
    "historical-seed:smoke": "node --experimental-strip-types scripts/historical-seed-smoke.ts",
    "integration:local": "node --experimental-strip-types scripts/local-integration.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "baseline:gate": "node --experimental-strip-types scripts/baseline-gate.ts",
    "backup:verify": "node --experimental-strip-types scripts/verify-backup-restore.ts",
    "launch:evidence": "node --experimental-strip-types scripts/verify-launch-evidence.ts",
    "checklist:audit": "node --experimental-strip-types scripts/checklist-audit.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "csv-parse": "^7.0.2",
    "date-fns": "4.1.0",
    "decimal.js": "^10.6.0",
    "embla-carousel-react": "8.5.2",
    "hono": "^4.13.7",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.3.0",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
