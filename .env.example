# Public browser configuration. Leave blank until Supabase is provisioned.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated exact browser origins allowed to receive auth callbacks.
# Leave blank for localhost development; production must set this explicitly.
NEXT_PUBLIC_AUTH_ORIGINS=

# Server-only configuration. Never use a service-role key in browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth provider secrets are server-side only. Configure these in the
# Supabase project (or local secret environment) when enabling Google OAuth.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
MARKETSTACK_API_KEY=
MARKETSTACK_MONTHLY_CAP=100
# Recurring Marketstack calls are opt-in during development. Leave false until
# a real free key and tiny smoke-test database write have been verified.
MARKETSTACK_SCHEDULE_ENABLED=false
# Budget guardrails are planning inputs in integer cents. Review before launch.
OPERATING_COST_TARGET_MAX_CENTS=7500
OPERATING_COST_ESCALATION_CENTS=10000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_MONTHLY_PRICE_CENTS=500
STRIPE_ANNUAL_PRICE_CENTS=4900
